# ==============================================================================
# MySQL Database Configuration
# ==============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_mysql_database_name
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_URL=jdbc:mysql://localhost:3306/your_mysql_database_name?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# ==============================================================================
# MongoDB Configuration
# ==============================================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=your_mongo_database_name
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_URI=mongodb://localhost:27017/your_mongo_database_name

# Marketplace MongoDB
MARKETPLACE_MONGO_DATABASE=your_marketplace_mongo_db
MARKETPLACE_MONGO_URI=mongodb://localhost:27017/your_marketplace_mongo_db

# ==============================================================================
# Payment & Mail Configuration
# ==============================================================================
RAZORPAY_API_KEY_ID=your_razorpay_key_id
RAZORPAY_API_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
SMTP_USERNAME=your_smtp_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password

# ==============================================================================
# Security / JWT
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_EXPIRATION_MS=86400000
