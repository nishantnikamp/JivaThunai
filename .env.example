# ==============================================================================
# MySQL Database Configuration
# ==============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=PetCareJT
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_URL=jdbc:mysql://localhost:3306/PetCareJT?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# ==============================================================================
# MongoDB Configuration
# ==============================================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=PetCareJT
MONGO_USER=
MONGO_PASSWORD=
MONGO_URI=mongodb://localhost:27017/PetCareJT

# Marketplace MongoDB
MARKETPLACE_MONGO_DATABASE=jivathunai_marketplace
MARKETPLACE_MONGO_URI=mongodb://localhost:27017/jivathunai_marketplace

# ==============================================================================
# Payment & Mail Configuration
# ==============================================================================
RAZORPAY_API_KEY_ID=your_razorpay_key_id_here
RAZORPAY_API_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_secure_webhook_secret_here
SMTP_USERNAME=your_smtp_email@example.com
SMTP_PASSWORD=your_app_password_here

# ==============================================================================
# Security / JWT
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000
